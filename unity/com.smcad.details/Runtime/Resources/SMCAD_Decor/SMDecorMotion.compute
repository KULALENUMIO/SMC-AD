// SPDX-License-Identifier: MIT
// SMC-DETAILS decorations: motion at run time, written straight into the decoration's vertex buffer.
//   Sway:      cloth / net vertices are pushed by wind (with gusts and flutter), the vehicle's acceleration and gun
//              blasts, scaled by how free the vertex hangs (UV1.x, from the drape). Rest shape from buffers.
//   Rope*:     chains are simulated (world space): pins follow the part, verlet + gravity + wind, Jacobi link
//              constraints, contact with the distance field (in the space the field was built in), then every link's
//              frame is carried along with the minimal rotation and its vertices are placed rigidly.
#pragma kernel Sway
#pragma kernel RopeIntegrate
#pragma kernel RopeSolve
#pragma kernel RopeCollide
#pragma kernel RopeTether
#pragma kernel RopeFrames
#pragma kernel RopeSkin

RWByteAddressBuffer _VB;            // the mesh's vertex buffer (stream 0)
uint _Stride, _PosOff, _NrmOff, _Count;
float4x4 _PartToWorld, _WorldToPart;

// ------------------------------------------------------------------ noise
float Hash(float3 p) { p = frac(p * 0.3183099 + 0.1); p *= 17.0; return frac(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float Noise(float3 x)
{
    float3 i = floor(x), f = frac(x);
    f = f * f * (3 - 2 * f);
    return lerp(lerp(lerp(Hash(i), Hash(i + float3(1, 0, 0)), f.x), lerp(Hash(i + float3(0, 1, 0)), Hash(i + float3(1, 1, 0)), f.x), f.y),
                lerp(lerp(Hash(i + float3(0, 0, 1)), Hash(i + float3(1, 0, 1)), f.x), lerp(Hash(i + float3(0, 1, 1)), Hash(i + float3(1, 1, 1)), f.x), f.y), f.z);
}

void StorePos(uint v, float3 p) { _VB.Store3(v * _Stride + _PosOff, asuint(p)); }
void StoreNrm(uint v, float3 n) { _VB.Store3(v * _Stride + _NrmOff, asuint(n)); }

// ------------------------------------------------------------------ cloth / net sway (part space)
StructuredBuffer<float3> _RestPos;
StructuredBuffer<float3> _RestNrm;
StructuredBuffer<float2> _Free;     // x = how free it hangs (0..1), y = 1 for leaf strips
float _Time, _Sway, _FlutterAmp, _FlutterFreq, _MaxOff, _Amount;
float3 _WindLocal;                   // wind velocity in part space (m/s)
float3 _InertiaLocal;                // offset from the vehicle's acceleration (m, part space)
float4 _BlastPos[4];                 // xyz part space, w strength (m)
float4 _BlastDir[4];                 // xyz direction, w radius

[numthreads(64, 1, 1)]
void Sway(uint3 id : SV_DispatchThreadID)
{
    uint v = id.x;
    if (v >= _Count) return;
    float3 p = _RestPos[v], n = _RestNrm[v];
    float2 fr = _Free[v];
    float f = saturate(fr.x) * _Amount;
    float speed = length(_WindLocal);
    float3 wdir = speed > 1e-4 ? _WindLocal / speed : float3(1, 0, 0);
    float gust = Noise(p * 0.45 - wdir * _Time * (0.6 + speed * 0.15));
    float3 off = _WindLocal * (_Sway * (0.35 + 0.9 * gust));
    float ph = _Time * _FlutterFreq * (1 + fr.y * 0.8) + dot(p, float3(2.1, 3.3, 1.7)) * 3.0;
    off += n * (sin(ph) + 0.5 * sin(ph * 2.3 + 1.1)) * _FlutterAmp * (0.3 + speed * 0.12) * (1 + fr.y * 1.5);
    off += _InertiaLocal;
    [unroll] for (int b = 0; b < 4; b++)
    {
        float3 d = p - _BlastPos[b].xyz;
        float r = max(_BlastDir[b].w, 0.1);
        float w = _BlastPos[b].w / (1 + dot(d, d) / (r * r));
        off += normalize(d + _BlastDir[b].xyz * 0.5 + 1e-5) * w;
    }
    off *= f;
    float l = length(off), lim = _MaxOff * f;
    if (l > lim && l > 1e-6) off *= lim / l;
    StorePos(v, p + off);
}

// ------------------------------------------------------------------ chains (world space)
RWStructuredBuffer<float4> _Pos;        // xyz world
RWStructuredBuffer<float4> _Prev;
StructuredBuffer<float4> _PosIn;
RWStructuredBuffer<float4> _PosOut;
StructuredBuffer<float3> _RestLocal;   // particle rest positions (part space)
StructuredBuffer<int2> _Nbr;           // prev, next (-1 none)
StructuredBuffer<float2> _Len;         // rest length to prev, to next
StructuredBuffer<float> _Radius;
StructuredBuffer<uint> _Pin;
RWStructuredBuffer<float4> _FrameA;    // axis (world)
RWStructuredBuffer<float4> _FrameZ;    // carried normal (world)
StructuredBuffer<float3> _RestAxis;    // rest axis (part space)
StructuredBuffer<float3> _RestZ;       // rest normal (part space)
StructuredBuffer<int> _VLink;          // per vertex: link (-1 = fixed fitting)
StructuredBuffer<float3> _VLocal;      // per vertex: offset in the rest link frame (axis, y, z)
StructuredBuffer<float3> _VNrmLocal;
StructuredBuffer<float3> _VRest;       // per vertex rest position (part space) for fixed fittings
StructuredBuffer<float3> _VRestNrm;

uint _N;
float _Dt, _Damp, _Omega;
float3 _Gravity;      // m/s^2 world
float3 _WindAcc;      // m/s^2 world
float4 _BlastW[4];    // xyz world pos, w impulse (m/s)
float4 _BlastWDir[4]; // xyz dir, w radius

Texture3D<float> _Field;
SamplerState sampler_linear_clamp;
float4x4 _FieldFromWorld, _WorldFromField;
float3 _GridMin, _GridSize;
float _Voxel, _MaxDist;

float FieldDist(float3 f)
{
    float3 uvw = (f - _GridMin) / _GridSize;
    if (any(uvw < 0) || any(uvw > 1)) return _MaxDist;
    return _Field.SampleLevel(sampler_linear_clamp, uvw, 0);
}
float3 FieldGrad(float3 f)
{
    float h = _Voxel;
    float3 g = float3(FieldDist(f + float3(h, 0, 0)) - FieldDist(f - float3(h, 0, 0)),
                      FieldDist(f + float3(0, h, 0)) - FieldDist(f - float3(0, h, 0)),
                      FieldDist(f + float3(0, 0, h)) - FieldDist(f - float3(0, 0, h)));
    float l = length(g);
    return l > 1e-6 ? g / l : float3(0, 1, 0);
}

[numthreads(64, 1, 1)]
void RopeIntegrate(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _N) return;
    if (_Pin[i] != 0)
    {
        float3 w = mul(_PartToWorld, float4(_RestLocal[i], 1)).xyz;
        _Pos[i] = float4(w, 0); _Prev[i] = float4(w, 0);
        return;
    }
    float3 x = _Pos[i].xyz, pv = _Prev[i].xyz;
    float3 vel = (x - pv) * _Damp;
    float gustN = Noise(x * 0.8 + _WindAcc * _Dt * 30);
    float3 acc = _Gravity + _WindAcc * (0.4 + gustN);
    [unroll] for (int b = 0; b < 4; b++)
    {
        float3 d = x - _BlastW[b].xyz;
        float r = max(_BlastWDir[b].w, 0.1);
        vel += normalize(d + _BlastWDir[b].xyz * 0.5 + 1e-5) * (_BlastW[b].w * _Dt / (1 + dot(d, d) / (r * r)));
    }
    _Prev[i] = float4(x, 0);
    _Pos[i] = float4(x + vel + acc * _Dt * _Dt, 0);
}

[numthreads(64, 1, 1)]
void RopeSolve(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _N) return;
    float3 p = _PosIn[i].xyz;
    if (_Pin[i] != 0) { _PosOut[i] = float4(p, 0); return; }
    int2 nb = _Nbr[i];
    float2 rl = _Len[i];
    float3 corr = 0; float cnt = 0;
    [unroll] for (int s = 0; s < 2; s++)
    {
        int q = s == 0 ? nb.x : nb.y;
        if (q < 0) continue;
        float3 d = _PosIn[q].xyz - p;
        float len = length(d);
        if (len < 1e-7) continue;
        float w = _Pin[q] != 0 ? 1.0 : 0.5;
        corr += d * ((len - (s == 0 ? rl.x : rl.y)) / len * w);
        cnt += 1;
    }
    _PosOut[i] = float4(p + corr * _Omega, 0);
}

[numthreads(64, 1, 1)]
void RopeCollide(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _N || _Pin[i] != 0) return;
    float3 x = _Pos[i].xyz;
    float3 f = mul(_FieldFromWorld, float4(x, 1)).xyz;
    float d = FieldDist(f);
    float r = _Radius[i];
    if (d < r)
    {
        float3 g = mul((float3x3)_WorldFromField, FieldGrad(f));
        x += normalize(g) * (r - d);
        _Prev[i] = float4(lerp(_Prev[i].xyz, x, 0.6), 0);
        _Pos[i] = float4(x, 0);
    }
}

StructuredBuffer<int2> _Tether;        // nearest pinned particle towards prev / next (-1 none)
StructuredBuffer<float2> _TetherLen;   // length along the chain to them

// long-range attachment: never farther from a pin than the chain length to it (stops a Jacobi-solved chain stretching)
[numthreads(64, 1, 1)]
void RopeTether(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _N || _Pin[i] != 0) return;
    float3 x = _Pos[i].xyz;
    int2 t = _Tether[i];
    float2 L = _TetherLen[i];
    [unroll] for (int s = 0; s < 2; s++)
    {
        int q = s == 0 ? t.x : t.y;
        if (q < 0) continue;
        float3 d = x - _Pos[q].xyz;
        float len = length(d), lim = (s == 0 ? L.x : L.y) * 1.01;
        if (len > lim) x -= d * ((len - lim) / len);
    }
    _Pos[i] = float4(x, 0);
}

float3 RotateMin(float3 v, float3 from, float3 to)
{
    float3 c = cross(from, to);
    float s = length(c), co = dot(from, to);
    if (s < 1e-6) return co > 0 ? v : -v;
    float3 k = c / s;
    return v * co + cross(k, v) * s + k * dot(k, v) * (1 - co);   // Rodrigues
}

[numthreads(64, 1, 1)]
void RopeFrames(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _N) return;
    int2 nb = _Nbr[i];
    float3 a = _Pos[nb.y >= 0 ? nb.y : i].xyz - _Pos[nb.x >= 0 ? nb.x : i].xyz;
    float3 ra = normalize(mul((float3x3)_PartToWorld, _RestAxis[i]));
    float3 rz = normalize(mul((float3x3)_PartToWorld, _RestZ[i]));
    float l = length(a);
    float3 axis = l > 1e-6 ? a / l : ra;
    float3 z = normalize(RotateMin(rz, ra, axis));
    _FrameA[i] = float4(axis, 0);
    _FrameZ[i] = float4(z, 0);
}

[numthreads(64, 1, 1)]
void RopeSkin(uint3 id : SV_DispatchThreadID)
{
    uint v = id.x;
    if (v >= _Count) return;
    int l = _VLink[v];
    if (l < 0) { StorePos(v, _VRest[v]); StoreNrm(v, _VRestNrm[v]); return; }
    float3 ax = _FrameA[l].xyz, z = _FrameZ[l].xyz, y = cross(z, ax);
    float3 lo = _VLocal[v], ln = _VNrmLocal[v];
    float3 w = _Pos[l].xyz + ax * lo.x + y * lo.y + z * lo.z;
    float3 wn = ax * ln.x + y * ln.y + z * ln.z;
    StorePos(v, mul(_WorldToPart, float4(w, 1)).xyz);
    StoreNrm(v, normalize(mul((float3x3)_WorldToPart, wn)));
}
