// SPDX-License-Identifier: MIT
// SMC-DETAILS decorations: draping a sheet on the GPU (position-based dynamics on a regular grid).
//   Integrate: verlet step with gravity and damping, swept against the distance field (thin plates are not skipped)
//   Solve:     Jacobi pass over the stretch / shear / bend constraints of every point (gathered from its neighbours,
//              cut cells leave theirs out), ping-pong
//   Collide:   out of the body along the field's gradient, friction, the floor under the vehicle. SM vehicles are
//              hollow shells (the field is open again under a turret roof), so each point remembers the last place
//              where it was clearly clear of the body (_Safe): a surface crossed since then (constraints can pull a
//              point through a thin plate) puts it back before that surface, and the push out of a plate goes to the
//              side it came from. Without this a sheet falls through the roof and floor by floor to the bottom.
#pragma kernel Integrate
#pragma kernel Solve
#pragma kernel Collide

RWStructuredBuffer<float4> _Pos;
RWStructuredBuffer<float4> _Prev;
RWStructuredBuffer<float4> _Safe;     // last position clear of the body
StructuredBuffer<float4> _PosIn;
RWStructuredBuffer<float4> _PosOut;
StructuredBuffer<uint> _Flags;      // bit 0 pinned, bit 1 used
StructuredBuffer<uint> _Alive;      // per cell (nu-1) x (nv-1)

Texture3D<float> _Field;
SamplerState sampler_linear_clamp;
float3 _GridMin, _GridSize;
float _Voxel, _MaxDist;

int2 _N;            // points nu, nv
float _Du, _Dv, _Diag, _Bend;
float _Thick, _Damp, _Floor, _Omega, _PoleR;
float3 _Down, _Gstep;

float Dist(float3 p)
{
    float3 uvw = (p - _GridMin) / _GridSize;
    if (any(uvw < 0) || any(uvw > 1)) return _MaxDist;
    return _Field.SampleLevel(sampler_linear_clamp, uvw, 0);
}

float3 Grad(float3 p)
{
    float h = _Voxel;
    float3 g = float3(Dist(p + float3(h, 0, 0)) - Dist(p - float3(h, 0, 0)),
                      Dist(p + float3(0, h, 0)) - Dist(p - float3(0, h, 0)),
                      Dist(p + float3(0, 0, h)) - Dist(p - float3(0, 0, h)));
    float l = length(g);
    return l > 1e-6 ? g / l : -_Down;
}


// A thin upright thing (antenna, rod, pole, up to the cloth's poleWidth across): the sheet does not rest on it (it would hang
// in a tall cone); the pole goes through the sheet instead. The thing's middle is found under the point (touching its
// top) or behind it (touching its side: how far it goes on along the push direction); from there it must be open on
// all four sides, there and 12 cm lower. Walls, plates and bars are long one way, so they still hold the sheet.
bool Pole(float3 p)
{
    if (_PoleR <= 0) return false;
    float d = Dist(p);
    float3 g = Grad(p);
    float3 gh = g - _Down * dot(g, _Down);
    float3 c;
    if (length(gh) < 0.5) c = p + _Down * (d + _Thick);
    else
    {
        float3 n = normalize(gh);
        float w = -1;
        for (int s = 1; s <= 12; s++)
        {
            float a = d + 2 * _PoleR * s / 12.0;
            if (Dist(p - n * a) > _Thick) { w = a - d; break; }
        }
        if (w < 0) return false;
        c = p - n * (d + w * 0.5);
    }
    float3 h1 = normalize(cross(_Down, abs(_Down.x) < 0.9 ? float3(1, 0, 0) : float3(0, 0, 1)));
    float3 h2 = cross(_Down, h1);
    [unroll] for (int k = 0; k < 2; k++)
    {
        float3 q = c + _Down * (k == 0 ? 0 : 0.12);
        if (Dist(q + h1 * _PoleR) < _Thick || Dist(q - h1 * _PoleR) < _Thick ||
            Dist(q + h2 * _PoleR) < _Thick || Dist(q - h2 * _PoleR) < _Thick) return false;
    }
    return true;
}

bool Cell(int i, int j) { return i >= 0 && j >= 0 && i < _N.x - 1 && j < _N.y - 1 && _Alive[i + (_N.x - 1) * j] != 0; }
uint Idx(int i, int j) { return (uint)(i + _N.x * j); }

[numthreads(64, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    uint k = id.x;
    if (k >= (uint)(_N.x * _N.y)) return;
    uint f = _Flags[k];
    if ((f & 1) != 0 || (f & 2) == 0) return;
    float3 x = _Pos[k].xyz, pv = _Prev[k].xyz;
    float3 stepV = (x - pv) * _Damp + _Gstep;
    float3 prevNew = x;
    float len = length(stepV);
    float probe = _Thick * 0.5;
    if (len > probe)
    {
        int n = min(48, (int)ceil(len / probe));
        for (int s = 1; s <= n; s++)
            if (Dist(x + stepV * ((float)s / n)) < _Thick && !Pole(x + stepV * ((float)s / n)))
            {
                stepV *= (float)(s - 1) / n;
                prevNew = x + stepV;
                break;
            }
    }
    _Prev[k] = float4(prevNew, 0);
    _Pos[k] = float4(x + stepV, 0);
}

void Constraint(inout float3 corr, inout float cnt, float3 p, int i2, int j2, float rest, float kk)
{
    uint q = Idx(i2, j2);
    uint fq = _Flags[q];
    if ((fq & 2) == 0) return;
    float3 d = _PosIn[q].xyz - p;
    float len = length(d);
    if (len < 1e-7) return;
    float diff = (len - rest) / len;
    if (kk < 1 && diff < 0) diff *= kk;
    float w = (fq & 1) != 0 ? 1.0 : 0.5;     // a pinned neighbour does not move: this point takes all of it
    corr += d * (diff * kk * w);
    cnt += 1;
}

[numthreads(8, 8, 1)]
void Solve(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x, j = (int)id.y;
    if (i >= _N.x || j >= _N.y) return;
    uint k = Idx(i, j);
    float3 p = _PosIn[k].xyz;
    uint f = _Flags[k];
    if ((f & 1) != 0 || (f & 2) == 0) { _PosOut[k] = float4(p, 0); return; }
    float3 corr = 0; float cnt = 0;
    // stretch
    if (i + 1 < _N.x && (Cell(i, j - 1) || Cell(i, j))) Constraint(corr, cnt, p, i + 1, j, _Du, 1);
    if (i - 1 >= 0 && (Cell(i - 1, j - 1) || Cell(i - 1, j))) Constraint(corr, cnt, p, i - 1, j, _Du, 1);
    if (j + 1 < _N.y && (Cell(i - 1, j) || Cell(i, j))) Constraint(corr, cnt, p, i, j + 1, _Dv, 1);
    if (j - 1 >= 0 && (Cell(i - 1, j - 1) || Cell(i, j - 1))) Constraint(corr, cnt, p, i, j - 1, _Dv, 1);
    // shear
    if (Cell(i, j)) Constraint(corr, cnt, p, i + 1, j + 1, _Diag, 0.6);
    if (Cell(i - 1, j - 1)) Constraint(corr, cnt, p, i - 1, j - 1, _Diag, 0.6);
    if (Cell(i, j - 1)) Constraint(corr, cnt, p, i + 1, j - 1, _Diag, 0.6);
    if (Cell(i - 1, j)) Constraint(corr, cnt, p, i - 1, j + 1, _Diag, 0.6);
    // bend (every other point)
    if (i + 2 < _N.x && (Cell(i, j - 1) || Cell(i, j)) && (Cell(i + 1, j - 1) || Cell(i + 1, j))) Constraint(corr, cnt, p, i + 2, j, _Du * 2, _Bend);
    if (i - 2 >= 0 && (Cell(i - 2, j - 1) || Cell(i - 2, j)) && (Cell(i - 1, j - 1) || Cell(i - 1, j))) Constraint(corr, cnt, p, i - 2, j, _Du * 2, _Bend);
    if (j + 2 < _N.y && (Cell(i - 1, j) || Cell(i, j)) && (Cell(i - 1, j + 1) || Cell(i, j + 1))) Constraint(corr, cnt, p, i, j + 2, _Dv * 2, _Bend);
    if (j - 2 >= 0 && (Cell(i - 1, j - 2) || Cell(i, j - 2)) && (Cell(i - 1, j - 1) || Cell(i, j - 1))) Constraint(corr, cnt, p, i, j - 2, _Dv * 2, _Bend);
    if (cnt > 0) p += corr * (_Omega / cnt) * min(cnt, 4.0);
    _PosOut[k] = float4(p, 0);
}

[numthreads(64, 1, 1)]
void Collide(uint3 id : SV_DispatchThreadID)
{
    uint k = id.x;
    if (k >= (uint)(_N.x * _N.y)) return;
    uint f = _Flags[k];
    if ((f & 1) != 0 || (f & 2) == 0) return;
    float3 x = _Pos[k].xyz, pv = _Prev[k].xyz, s = _Safe[k].xyz;
    // a surface crossed since the last safe place: back to just before it
    float3 dv = x - s;
    float len = length(dv);
    float probe = _Thick * 0.25;
    if (len > probe)
    {
        int n = min(64, (int)ceil(len / probe));
        for (int i = 1; i <= n; i++)
            if (Dist(s + dv * ((float)i / n)) < _Thick * 0.5 && !Pole(s + dv * ((float)i / n)))
            {
                x = s + dv * ((float)(i - 1) / n);
                pv = lerp(pv, x, 0.7);
                break;
            }
    }
    float d = Dist(x);
    if (d < _Thick && !Pole(x))
    {
        // out along the slope of the field, to the side the point came from
        float3 g = Grad(x);
        float3 toSafe = s - x;
        if (dot(toSafe, toSafe) > 1e-8 && dot(g, toSafe) < 0) g = -g;
        x += g * (_Thick - d);
        pv = lerp(pv, x, 0.7);
    }
    float depth = dot(x, _Down);
    if (depth > _Floor) { x -= _Down * (depth - _Floor); pv = lerp(pv, x, 0.8); }
    _Pos[k] = float4(x, 0);
    _Prev[k] = float4(pv, 0);
    if (Dist(x) >= _Thick * 0.7 || Pole(x)) _Safe[k] = float4(x, 0);
}
